<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsHeading"
                        android:text="@string/section_cloud" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/section_cloud_summary" />

                    <TextView
                        style="@style/SettingsSubheading"
                        android:text="@string/cloud_section" />

                    <RadioGroup
                        android:id="@+id/provider_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/provider_google"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/provider_google" />
                        <RadioButton
                            android:id="@+id/provider_dropbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/provider_dropbox" />
                    </RadioGroup>

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/drive_status" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dropbox_setup"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/dropbox_setup" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/wifi_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/wifi_only" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/delete_after_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_after_upload" />

                    <TextView
                        style="@style/SettingsSubheading"
                        android:text="@string/background_heading" />

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/battery_status" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/battery_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/battery_button" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsHeading"
                        android:text="@string/section_recording" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/section_recording_summary" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/segment_seconds"
                        app:helperText="@string/segment_help">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/segment_seconds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/dual_camera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/dual_camera" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsHeading"
                        android:text="@string/pin_section" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/section_protection_summary" />

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/pin_status" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/pin_new_short"
                        app:helperText="@string/pin_new_help">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/new_pin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/remove_pin"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/pin_remove" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/biometric_unlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/biometric_switch" />

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/biometric_note" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/widget_double_tap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/widget_double_tap" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsHeading"
                        android:text="@string/sms_section" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/section_alerts_summary" />

                    <TextView
                        style="@style/SettingsSubheading"
                        android:text="@string/emergency_contacts" />

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/no_contacts"
                        android:text="@string/no_contacts" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/contacts_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_from_contacts"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:layout_marginEnd="8dp"
                            android:text="@string/add_from_contacts" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_number"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/add_number" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/sms_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sms_allow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sms_allow" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/alert_message">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/alert_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/SettingsSubheading"
                        android:text="@string/alerts_when" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sms_on_stop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sms_on_stop" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/location_update_short"
                        app:helperText="@string/location_update_help">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/location_minutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/share_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/share_footage_link" />

                    <TextView
                        style="@style/SettingsNote"
                        android:text="@string/share_footage_help" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send_test"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/send_test" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsHeading"
                        android:text="@string/section_help" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/section_help_summary" />

                    <TextView
                        style="@style/SettingsNote"
                        android:id="@+id/storage_path" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/share_diagnostics"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/share_diagnostics" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/save" />
</LinearLayout>
